# =========================================================
# EnerWise - .gitignore
# Covers: backend (Node/Express) + frontend + producer/consumer (Python) +
# spark (PySpark) + Docker + Snowflake logs + sensitive/generated files
# =========================================================

# ---------------------------------------------------------
# Secrets / credentials - most important section, don't remove any of this
# ---------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ---------------------------------------------------------
# Node / npm (backend)
# ---------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
yarn-debug.log*
package-lock.json.bak
.npm/

# ---------------------------------------------------------
# Logs (Snowflake SDK, and general logs)
# ---------------------------------------------------------
*.log
backend/snowflake.log

# ---------------------------------------------------------
# Python / PySpark (producer, consumer, spark)
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---------------------------------------------------------
# Files generated by the pipeline (not core source data, auto-generated)
# ** is used so it matches regardless of folder depth (EnerWise/spark/inspection, etc.)
# ---------------------------------------------------------
**/consumer/output/
**/consumer/temp/
**/spark/inspection/*.csv

# To exclude large raw data CSVs from the repo, uncomment the line below:
# **/data/*.csv

# Stray empty files accidentally named "docker" (0 bytes) - in case they reappear
**/docker
!**/docker-compose*.yml

# ---------------------------------------------------------
# Docker
# ---------------------------------------------------------
docker/volumes/
*.pid

# ---------------------------------------------------------
# OS / editors
# ---------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---------------------------------------------------------
# General temp files
# ---------------------------------------------------------
*.tmp
*.bak
